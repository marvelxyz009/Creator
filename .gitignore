# Orchestrator runtime artifacts
# Keep the directory itself (for the .gitkeep marker) but ignore generated runs.
orchestrator/runs/*
!orchestrator/runs/.gitkeep

# Sample-level generated runs (do not commit; goldens live in outputs/)
samples/*/generated/

# Memory graph working files (canonical graph is committed separately when intentional)
*.graph.working.json
