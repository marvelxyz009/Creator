# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
.python-version

# Environment files
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
