# AetherForge Orchestrator — environment configuration
#
# Copy this file to .env and fill in real values. The .env file is gitignored.
#
# Only ANTHROPIC_API_KEY is required for MVP. Everything else has sensible
# defaults the orchestrator picks if the variable is unset.

# ─── Required ────────────────────────────────────────────────────────────────

# Your Anthropic API key. Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here


# ─── Optional ────────────────────────────────────────────────────────────────

# Default model used by all agents unless a workflow pins something else.
# Recommended: claude-opus-4-7 for generative agents; claude-sonnet-4-6 for
# validators (cheaper, fast enough). The orchestrator's model registry
# (orchestrator/llm/models.py) maps agent_id → model so you rarely need this.
# ANTHROPIC_MODEL=claude-opus-4-7

# Log verbosity. DEBUG | INFO | WARNING | ERROR.
# AETHERFORGE_LOG_LEVEL=INFO

# Override the runs/ output directory if you want runs written elsewhere
# (e.g. a scratch volume). Default: <repo>/orchestrator/runs/
# AETHERFORGE_RUNS_DIR=

# Override the repo root if running from outside the repo. Default: auto-detect
# by walking up from the orchestrator package's __file__.
# AETHERFORGE_REPO_ROOT=

# Optional: cap on max tokens per LLM call. Default: 4096.
# ANTHROPIC_MAX_TOKENS=4096
